POSTGRES_DB=pusaka
POSTGRES_USER=pusaka
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_PORT=5432

# Full connection string — dipakai Go API dan migration script
# Dev  : PostgreSQL bisa share container dengan app lain (beda DB, beda user)
# Prod : Sesuaikan host dengan IP VPS2
DATABASE_URL=postgresql://pusaka:ganti-dengan-password-kuat@localhost:5432/pusaka

# Go API
PORT=8080
JWT_SECRET=ganti-dengan-secret-panjang-acak
ADMIN_PASSWORD=admin        # hanya dipakai saat pertama kali seed, ubah via API setelah itu
WORKER_API_KEY=ganti-dengan-api-key-worker
