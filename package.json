{
  "name": "mtsn2kolut-super-app",
  "private": true,
  "workspaces": [
    "apps/web-admin",
    "services/pusaka-worker",
    "services/core-api/db/scripts"
  ],
  "scripts": {
    "check:web": "npm --prefix apps/web-admin run check",
