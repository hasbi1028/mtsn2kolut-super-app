# ── Playwright Worker ─────────────────────────────────────────────────────────
# Salin ke .env dan sesuaikan nilai-nilainya.
# Worker memanggil Go API backend langsung — tidak butuh akses ke SvelteKit.
# Worker auth hanya terhadap backend Go.

# URL Go API backend VPS-Backend (wajib)
BACKEND_URL=http://IP-VPS-BACKEND:8080

# Worker API key — harus sama persis dengan WORKER_API_KEY di backend (wajib di production)
WORKER_API_KEY=isi-worker-api-key-yang-kuat

# ID unik per VPS worker (wajib jika deploy ke lebih dari 1 VPS)
WORKER_ID=worker-vps1

# Jumlah job yang berjalan paralel per worker (default 5)
WORKER_CONCURRENCY=5

# Jalankan Chromium tanpa tampilan GUI (true di server, false untuk debug lokal)
HEADLESS=true

# Interval sinkron config runtime dari backend dalam milidetik (default 30000)
CONFIG_SYNC_MS=30000

# Interval polling job baru dalam milidetik (default 8000)
POLL_MS=8000

# Jumlah retry per job sebelum dianggap failed (default 3)
SCRAPE_RETRIES=3

# Jeda antar retry dalam milidetik — dikalikan nomor attempt (default 5000)
SCRAPE_RETRY_MS=5000

# Timeout tiap aksi Playwright dalam milidetik (default 20000)
ACTION_TIMEOUT=20000

# Path file log worker (opsional)
WORKER_LOG_PATH=../logs/worker.log

# Direktori simpan screenshot saat job gagal (opsional)
SCREENSHOT_DIR=../logs/screenshots
