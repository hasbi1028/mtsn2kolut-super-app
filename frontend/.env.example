# ── SvelteKit Frontend ────────────────────────────────────────────────────────
# Salin ke .env dan sesuaikan nilai-nilainya.

# Bind address & port
HOST=0.0.0.0
PORT=8021

NODE_ENV=production

# Path SQLite (relatif dari direktori frontend/, atau path absolut)
DB_PATH=../data/pusaka.sqlite

# Secret bersama antara frontend dan semua worker VPS (wajib di production)
WORKER_TOKEN=isi-secret-yang-kuat-dan-sama-di-semua-vps

# Perintah untuk restart worker dari UI (opsional)
# WORKER_RESTART_CMD=/absolut/path/ke/scripts/restart-worker.sh

# Path log aplikasi frontend (opsional, default ../logs/app.log)
# APP_LOG_PATH=../logs/app.log
